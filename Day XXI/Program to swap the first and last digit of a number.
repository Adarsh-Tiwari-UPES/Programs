//Q41: Write a program to swap the first and last digit of a number.
/*
Sample Test Cases:
Input 1:
1234
Output 1:
4231
Input 2:
1001
Output 2:
1001
*/

#include <stdio.h>
int main() {
int n;
int first;
int last;
int temp;
int places = 1;
if (scanf("%d", &n) != 1) {
return 1;
}
last = n % 10;
temp = n;
while (temp >= 10) {
temp /= 10;
places *= 10;
}
first = temp;
int swapped = last * places + (n % places) / 10 * 10 + first;
printf("%d\n", swapped);
return 0;
}
